# Copy this file to .env and replace the local placeholder passwords.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
# Production only: use a real public hostname and set WEB_ORIGIN=https://APP_DOMAIN.
APP_DOMAIN=parking.example.com
# Production compose trusts the Caddy -> Nginx proxy chain (2 hops); local development uses 0.
TRUST_PROXY_HOPS=0
SESSION_TTL_HOURS=168

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartpark
DB_USER=smartpark_app
DB_PASSWORD=change_this_local_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Optional locally; development verification links print in the API terminal.
# Production registration requires working SMTP email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SmartPark <no-reply@your-domain.example>


# Payments. Keep mock mode for local development only; production requires Razorpay.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Replace with a unique random secret (at least 32 characters) before deployment.
QR_SIGNING_SECRET=local-development-only-smartpark-qr-secret-change-before-deployment

# Phase 7 computer-vision service. The Python service also loads this root .env.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
VISION_API_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters

# Production camera model build; YOLO/PyTorch adds a large image.
VISION_INSTALL_YOLO=true
