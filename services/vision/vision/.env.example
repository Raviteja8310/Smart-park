# Use the SAME secret as VISION_API_TOKEN in the repository-root .env.
VISION_API_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters
VISION_API_URL=http://127.0.0.1:4000/api/vision/service
VISION_HOST=127.0.0.1
VISION_PORT=8000
VISION_POLL_SECONDS=10
VISION_HEARTBEAT_SECONDS=10
VISION_DETECTION_EVERY_N_FRAMES=3
VISION_STABLE_FRAMES=3
VISION_MODEL_PATH=yolov8n.pt
VISION_MEDIA_ROOT=services/vision/sample-videos
VISION_ALLOW_RTSP=false
VISION_MAX_WORKERS=6
